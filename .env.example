# Optional: your own ScreenScraper dev credentials.
#
# The hero cartridges wear generated labels by default and make zero cover
# requests. Explicitly opt in and fill these in via a gitignored `.env.local`
# to resolve and cache real box art for the hero only. VITE_ variables are
# public client configuration: never put private account credentials here.
#
# VITE_ENABLE_HERO_COVER_ART=true
# VITE_SCREENSCRAPER_DEV_ID=
# VITE_SCREENSCRAPER_DEV_PASSWORD=
# VITE_SCREENSCRAPER_SOFT_NAME=roms-tn

# Optional: point the app at a different published ROM index.
# VITE_ATLAS_DATA_URL=
