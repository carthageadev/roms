# Required: Postgres connection string (Neon). Never commit the real value.
# Set it locally in `.env.local` (gitignored) and in the Vercel project settings.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Optional: a different published ROM index base (must serve meta.json + roms.json.gz).
ATLAS_DATA_URL="https://carthageadev.github.io/atlas/data"

# Optional: ScreenScraper dev configuration. Covers are fetched lazily, one
# title at a time, only when a real index entry is saved — never for browsing.
# The catalog backfill (POST /api/admin/backfill-covers) uses the same keys.
SCREENSCRAPER_DEV_ID=
SCREENSCRAPER_DEV_PASSWORD=
SCREENSCRAPER_SOFT_NAME=roms-tn

# Required to authorize the one-shot cover backfill route. Never commit it.
ADMIN_TOKEN=
